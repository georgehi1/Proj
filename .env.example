# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL  → the connection the app uses at runtime
# DIRECT_URL    → a direct connection used only for migrations
#
# Local development (matches docker-compose.yml) — both point at local Postgres:
DATABASE_URL="postgresql://homefix:homefix@localhost:5432/homefix?schema=public"
DIRECT_URL="postgresql://homefix:homefix@localhost:5432/homefix?schema=public"
#
# Supabase (production): in your project dashboard → Settings → Database →
# "Connection string". Use the *Transaction pooler* (port 6543) for DATABASE_URL
# and the *Direct connection* (port 5432) for DIRECT_URL. Example:
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Environment & monitoring ─────────────────────────────────────────────────
# Logical environment used to tag errors and gate behaviour. On Vercel this is
# derived automatically from VERCEL_ENV; set it explicitly for Docker/self-host.
#   development | preview | production
APP_ENV="development"
# Same value, exposed to the browser so client-side errors are tagged correctly.
NEXT_PUBLIC_APP_ENV="development"

# Sentry error monitoring (optional). Leave the DSN blank to disable Sentry
# entirely — the SDK is wired up but stays a no-op until a DSN is present.
# DSN from Sentry → Settings → Projects → (project) → Client Keys. Safe to expose.
NEXT_PUBLIC_SENTRY_DSN=""
# Performance trace sample rate, 0–1 (0 disables tracing). Server and client.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Source-map upload at build time (optional; set in CI / Vercel, not locally).
# Auth token: Sentry → Settings → Auth Tokens (needs project:releases scope).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# First admin account created by `prisma db seed`. Set a real password in production.
ADMIN_EMAIL="admin@homefixlimited.co.uk"
ADMIN_PASSWORD="password123"

# Set to "true" to also seed demo clients/jobs/invoices (local only — never in production).
SEED_DEMO="false"

# ─── AI extraction (optional) ─────────────────────────────────────────────────
# Enables AI import of quotes/invoices from PDFs & Word docs. Leave unset to disable.
ANTHROPIC_API_KEY=""

# ─── Attachment storage (optional) ────────────────────────────────────────────
# By default, job attachments are stored as bytes in Postgres (works with no
# setup). To offload them to Supabase Storage instead, set all three below; the
# app then uploads to the bucket and serves files by proxying through its
# authenticated download route (storage URLs are never exposed).
#   1. Create a private bucket (default name "attachments") in Supabase Storage.
#   2. Use the service_role key (Settings -> API) — server-side only, never expose it.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
ATTACHMENTS_BUCKET="attachments"

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Used to email quotes/invoices (as PDF attachments) to clients. Without a key,
# sends are logged to the server console instead (the invoice status still
# updates) so the flow works in dev. Uses Resend: https://resend.com
#   EMAIL_FROM must be an address on a domain you've verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Homefix Renovations <quotes@yourdomain.co.uk>"
