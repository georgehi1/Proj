// Homefix CRM — Prisma schema
// Run `npm run db:migrate` to apply changes locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled connection; migrations use the direct one.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CONTRACTOR
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum JobStatus {
  ENQUIRY
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationType {
  CALL
  EMAIL
  NOTE
  SITE_VISIT
}

enum InvoiceType {
  QUOTE
  INVOICE
}

enum MaterialStatus {
  NEEDED
  ORDERED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  PAID
  OVERDUE
  VOID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  communications      Communication[] @relation("CommunicationAuthor")
  uploadedAttachments JobAttachment[] @relation("AttachmentUploader")
  // A CONTRACTOR-role user is the login for exactly one Contractor record.
  contractor          Contractor?     @relation("ContractorLogin")
}

model Client {
  id           String     @id @default(cuid())
  name         String
  type         ClientType @default(RESIDENTIAL)
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  town         String?
  postcode     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobs           Job[]
  communications Communication[]
  invoices       Invoice[]

  @@index([name])
}

model Job {
  id            String    @id @default(cuid())
  reference     Int       @unique @default(autoincrement())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  notes         String?
  status        JobStatus @default(ENQUIRY)
  siteAddress   String?
  scheduledDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contractors    Contractor[]    @relation("JobContractors")
  communications Communication[]
  invoices       Invoice[]
  photos         JobPhoto[]
  attachments    JobAttachment[]
  materials      JobMaterial[]

  @@index([clientId])
  @@index([status])
}

// Materials required for a job — a simple procurement tracker
// (needed -> ordered -> received) with optional cost estimates.
model JobMaterial {
  id        String         @id @default(cuid())
  jobId     String
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  quantity  Decimal        @default(1) @db.Decimal(10, 2)
  unit      String?
  unitCost  Decimal?       @db.Decimal(10, 2)
  supplier  String?
  sku       String?
  sourceUrl String?
  status    MaterialStatus @default(NEEDED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([jobId])
}

model Communication {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type        CommunicationType @default(NOTE)
  body        String
  createdById String
  createdBy   User              @relation("CommunicationAuthor", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([clientId])
  @@index([jobId])
}

model Invoice {
  id        String        @id @default(cuid())
  type      InvoiceType   @default(INVOICE)
  number    Int
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  vatRate   Decimal       @default(20) @db.Decimal(5, 2)
  subtotal  Decimal       @default(0) @db.Decimal(10, 2)
  vatAmount Decimal       @default(0) @db.Decimal(10, 2)
  total     Decimal       @default(0) @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@unique([type, number])
  @@index([clientId])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal @default(0) @db.Decimal(10, 2)
  position    Int     @default(0)

  @@index([invoiceId])
}

// Photos attached to a job. The binary lives in the DB so it works in any
// environment with no extra storage setup; swap `data` for an object-storage
// URL (Vercel Blob / S3) if volumes grow.
model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  caption   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

// External tradespeople who carry out jobs. Office-managed records that may
// optionally be given a login (a linked CONTRACTOR-role User) so the
// tradesperson can see their own jobs and schedule via the contractor portal.
model Contractor {
  id          String   @id @default(cuid())
  name        String
  trade       String?
  companyName String?
  email       String?
  phone       String?
  dayRate     Decimal? @db.Decimal(10, 2)
  notes       String?
  active      Boolean  @default(true)
  // Optional self-service login. Null = office-managed only (no portal access).
  userId      String?  @unique
  user        User?    @relation("ContractorLogin", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[] @relation("JobContractors")

  availability ContractorAvailability[]

  @@index([name])
}

enum AvailabilityKind {
  AVAILABLE
  TIME_OFF
}

// A day-level window for a contractor. AVAILABLE = periods they can work;
// TIME_OFF = holidays/blocks that override availability. Dates are inclusive.
model ContractorAvailability {
  id           String           @id @default(cuid())
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  kind         AvailabilityKind @default(AVAILABLE)
  startDate    DateTime
  endDate      DateTime
  note         String?
  createdAt    DateTime         @default(now())

  @@index([contractorId])
}

// Arbitrary file attached to a job (certificates, plans, signed quotes, etc.).
// Bytes live in the DB so it works with no extra storage setup.
model JobAttachment {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  size         Int
  // Exactly one of `data` (bytes in-DB) or `storageKey` (object storage) is set.
  data         Bytes?
  storageKey   String?
  uploadedById String?
  uploadedBy   User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([jobId])
}

// One row per failed login, used to rate-limit / lock out brute-force attempts.
// Rows age out of the lockout window and are pruned opportunistically.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Single-row table (id = 1) holding company details for invoice/quote branding.
model CompanySettings {
  id             Int      @id @default(1)
  companyName    String   @default("Homefix Limited")
  addressLine1   String?
  addressLine2   String?
  town           String?
  postcode       String?
  phone          String?
  email          String?
  vatNumber      String?
  defaultVatRate Decimal  @default(20) @db.Decimal(5, 2)
  invoicePrefix  String   @default("INV")
  quotePrefix    String   @default("QUO")
  updatedAt      DateTime @updatedAt
}
